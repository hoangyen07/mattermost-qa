# Copy to .env and adjust
# Values match the seed commands in docs/devlog.md (day 2)

# Tests (keep the BASE_URL port in sync with MM_PORT)
BASE_URL=http://localhost:8065
MM_ADMIN_USERNAME=qaadmin
MM_ADMIN_PASSWORD=Passw0rd!123
MM_TEAM=qa-team

# Docker environment (read by `npm run env:*`)
# Postgres applies these only when the database volume is first created;
# changing them later requires `npm run env:reset` (deletes all data).
POSTGRES_USER=mmuser
POSTGRES_PASSWORD=mmuser_password
POSTGRES_DB=mattermost
MM_PORT=8065
