{
  "info": {
    "name": "Mattermost API",
    "description": "Exploratory API checks for Mattermost: login with a session token, then create and read a post.\n\nRun the folders in order: \"Happy path\" sets the token and ids used by later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('returns a session token in the Token header', () => {",
                  "    pm.expect(pm.response.headers.get('Token')).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "// The token is in the response header, not in the body",
                  "pm.environment.set('token', pm.response.headers.get('Token'));",
                  "pm.environment.set('userId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login_id\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Get current user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('returns the logged-in user', () => {",
                  "    pm.expect(pm.response.json().id).to.eql(pm.environment.get('userId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            }
          }
        },
        {
          "name": "Get channel by team and channel name",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('returns the requested channel', () => {",
                  "    pm.expect(pm.response.json().name).to.eql(pm.environment.get('channelName'));",
                  "});",
                  "",
                  "// The posts API needs the channel id, not its name",
                  "pm.environment.set('channelId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/teams/name/{{teamName}}/channels/name/{{channelName}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "teams",
                "name",
                "{{teamName}}",
                "channels",
                "name",
                "{{channelName}}"
              ]
            }
          }
        },
        {
          "name": "Create post",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique message per run, so an old post can never make the test pass",
                  "pm.variables.set('message', `Hello from Postman ${Date.now()}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 201 Created', () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const post = pm.response.json();",
                  "",
                  "pm.test('stores the message in the requested channel', () => {",
                  "    pm.expect(post.message).to.eql(pm.variables.get('message'));",
                  "    pm.expect(post.channel_id).to.eql(pm.environment.get('channelId'));",
                  "    pm.expect(post.user_id).to.eql(pm.environment.get('userId'));",
                  "});",
                  "",
                  "pm.environment.set('postId', post.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel_id\": \"{{channelId}}\",\n  \"message\": \"{{message}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get created post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('returns the post that was just created', () => {",
                  "    pm.expect(pm.response.json().message).to.eql(pm.variables.get('message'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Errors",
      "item": [
        {
          "name": "Login with invalid credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 401', () => {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "// Assert the error id, not the message: the id is stable, the text is not",
                  "pm.test('returns the expected error id', () => {",
                  "    pm.expect(pm.response.json().id).to.eql('api.user.login.invalid_credentials_email_username');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login_id\": \"no-such-user\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Get current user without token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 401', () => {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "// Assert the error id, not the message: the id is stable, the text is not",
                  "pm.test('returns the expected error id', () => {",
                  "    pm.expect(pm.response.json().id).to.eql('api.context.session_expired.app_error');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Create post without channel_id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Observed behaviour: a missing channel_id returns 403 (permissions), not 400 (validation).",
                  "// The permission check runs before body validation, so the error message is misleading.",
                  "pm.test('returns 403', () => {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "// Assert the error id, not the message: the id is stable, the text is not",
                  "pm.test('returns the expected error id', () => {",
                  "    pm.expect(pm.response.json().id).to.eql('api.context.permissions.app_error');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Missing channel id\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
